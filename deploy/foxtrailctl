#!/usr/bin/env bash
# Wrapper: fuehrt scripts/manage.py als Dienstbenutzer mit der Produktionskonfiguration aus.
#   foxtrailctl create-user admin --admin
#   foxtrailctl sync
#   foxtrailctl stats
set -euo pipefail
APP_DIR=/opt/foxtrail-tracker
ENV_FILE=/etc/foxtrail-tracker.env
set -a; . "$ENV_FILE"; set +a
if [[ $EUID -eq 0 ]]; then
  exec sudo -u foxtrail --preserve-env=FOXTRAIL_DB,FOXTRAIL_PASSWORD,FOXTRAIL_LIST_URL,SCRAPER_DELAY \
       "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/manage.py" "$@"
else
  exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/manage.py" "$@"
fi
