# /etc/foxtrail-tracker.env  -  wird von install.sh erzeugt (chmod 600)
# Session-Signatur: PFLICHT, zufaellig, geheim. Erzeugen mit:  openssl rand -hex 32
SECRET_KEY=bitte-ersetzen
# Adresse, auf der gunicorn lauscht. 0.0.0.0:8080 = im LAN erreichbar (auch fuer einen Reverse-
# Proxy in einem anderen Container). 127.0.0.1:8080 nur, wenn der Proxy im selben Container laeuft.
BIND=0.0.0.0:8080
# SQLite-Datenbank
FOXTRAIL_DB=/var/lib/foxtrail-tracker/foxtrail.db
# "1" = Login-Cookie nur ueber HTTPS. Nur setzen, wenn ausschliesslich ueber HTTPS zugegriffen
# wird - ueber http://<IP>:8080 klappt die Anmeldung danach nicht mehr.
FORCE_HTTPS=0
# Optional
#FOXTRAIL_LIST_URL=https://foxtrail.ch/kategorie/trails/
#SCRAPER_DELAY=1.0
#LOGIN_MAX_FAILS=5
#LOGIN_LOCK_SECONDS=300
# "0" = nicht bei GitHub nach neuen Versionen fragen (Hinweis am Zahnrad fuer Admins)
#FOXTRAIL_UPDATE_CHECK=1
